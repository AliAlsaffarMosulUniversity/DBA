{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ba-dms-mosul",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {"directory":"./frontend/dist", "binding":"ASSETS", "not_found_handling":"single-page-application", "run_worker_first":["/api/*"]},
  "vars": {"FIREBASE_PROJECT_ID":"ba-dms-mosul", "ADMIN_EMAIL":"ali_alsaffar@uomosul.edu.iq"},
  "ratelimits": [{"name":"API_LIMITER", "namespace_id":"301001", "simple":{"limit":60,"period":60}}],
  "observability": {"enabled":false}
}
